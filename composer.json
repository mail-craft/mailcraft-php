{
    "name": "mailcraft/mailcraft-php",
    "description": "Official PHP SDK for the MailCraft email API — transactional email, SMTP relay, marketing campaigns, automations, and contact management.",
    "version": "0.1.0",
    "type": "library",
    "license": "MIT",
    "keywords": ["email", "mailcraft", "transactional-email", "smtp", "email-api"],
    "homepage": "https://github.com/mail-craft/mailcraft-php",
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.8",
        "ext-json": "*"
    },
    "require-dev": {
        "pestphp/pest": "^2.34",
        "phpstan/phpstan": "^1.11"
    },
    "autoload": {
        "psr-4": {
            "MailCraft\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MailCraft\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "types:check": "phpstan analyse"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
